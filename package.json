{
  "name": "flashback-monorepo",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": [
    "packages/shared",
    "packages/flashback",
    "packages/mcp",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "build": "npm run build -w @flashback/shared && npm run build -w flashback-devtools && npm run build -w flashback-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "mcp": "node packages/mcp/dist/cli.js",
    "setup:browsers": "playwright install chromium",
    "release:check": "npm run build && npm pack --dry-run -w flashback-devtools -w flashback-mcp",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "node scripts/bench/run-all.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "tsup": "^8.3.5",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
