{
  "name": "flashback-mcp",
  "version": "0.1.0-beta.2",
  "description": "Flashback MCP sunucusu: tarayıcıdan gelen hata olaylarını AI kodlama ajanına iletir ve düzeltmeyi kırmızı→yeşil Playwright testiyle doğrular.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flashback-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.45.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flashback/shared": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinilkalp/flashback.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/yasinilkalp/flashback#readme",
  "bugs": {
    "url": "https://github.com/yasinilkalp/flashback/issues"
  },
  "keywords": [
    "mcp",
    "ai",
    "debugging",
    "playwright",
    "rrweb",
    "react",
    "devtools"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
