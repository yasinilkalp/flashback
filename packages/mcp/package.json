{
  "name": "flashback-mcp",
  "version": "0.2.0",
  "description": "Flashback MCP sunucusu: tarayıcıda işaretlenen hata raporlarını (.flashback/*.md) AI kodlama ajanına verir. \"Son hatayı düzelt\" demeniz yeter.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flashback-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinilkalp/flashback.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/yasinilkalp/flashback#readme",
  "bugs": {
    "url": "https://github.com/yasinilkalp/flashback/issues"
  },
  "keywords": [
    "mcp",
    "ai",
    "debugging",
    "react",
    "vite",
    "devtools",
    "claude-code",
    "cursor"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
